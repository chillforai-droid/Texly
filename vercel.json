    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/seo-page",
      "destination": "/api/seo-page"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|sitemap.xml|robots.txt|llms.txt|_next/|static/|assets/|favicon.ico).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|Baiduspider|YandexBot|DuckDuckBot|facebookexternalhit|LinkedInBot|Twitterbot|WhatsApp|Slackbot|TelegramBot).*"
        }
      ],
      "destination": "/api/prerender"
    },
    {
      "source": "/((?!api/|sitemap.xml|robots.txt|llms.txt|_next/|static/|assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ],
